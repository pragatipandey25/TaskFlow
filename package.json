{
  "name": "taskflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TaskFlow — Distributed Job Queue & Background Processing System",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace=shared && npm run build --workspace=backend && npm run build --workspace=frontend",
    "typecheck": "npm run typecheck --workspace=shared && npm run typecheck --workspace=backend && npm run typecheck --workspace=frontend",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lint": "eslint \"shared/src/**/*.ts\" \"backend/src/**/*.ts\"",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:worker": "npm run dev:worker --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml down",
    "docker:logs": "docker compose -f infrastructure/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3"
  }
}
