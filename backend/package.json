{
  "name": "@taskflow/backend",
  "version": "1.0.0",
  "description": "TaskFlow Backend API & Distributed Background Processing Engine",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker-entry.js",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker-entry.ts",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:coverage": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --coverage --runInBand --forceExit"
  },
  "dependencies": {
    "@taskflow/shared": "*",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.31.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "socket.io": "^4.8.1",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
